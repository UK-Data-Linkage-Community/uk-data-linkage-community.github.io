---
layout: null
---

[
{% for term in site.data.glossary %}
{
  "id": "{{ term.id }}",
  "label": "{{ term.label }}",
  "definition": "{{ term.definition | escape }}",
  "related": [{% for r in term.related %}"{{ r }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "conflicts": [{% for c in term.conflicts %}"{{ c }}"{% unless forloop.last %},{% endunless %}{% endfor %}]
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]